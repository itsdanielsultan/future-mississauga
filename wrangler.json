{
  "name": "future-mississauga-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/downloads/Future-Mississauga-Atlas.pdf"
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "future-mississauga-media"
    }
  ]
}
