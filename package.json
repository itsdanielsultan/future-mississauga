{
  "name": "future-mississauga",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent Mississauga model atlas, served entirely as static files.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run build && node scripts/verify-cloudflare-preview.mjs --staged",
    "build": "node scripts/prepare-cloudflare.mjs",
    "dev": "node scripts/serve.mjs",
    "build:gallery": "node scripts/build-gallery.mjs",
    "preview": "node scripts/serve.mjs --release",
    "build:ui": "node scripts/sync-footers.mjs && node scripts/build-ui.mjs",
    "build:catalogue": "node scripts/build-building-catalogue.mjs",
    "prebuild": "node scripts/build-map-stations.mjs && npm run build:catalogue && npm run build:gallery && npm run build:ui",
    "build:cloudflare": "node scripts/prepare-cloudflare.mjs",
    "check:pages": "node scripts/check-publication.mjs",
    "build:pages": "node scripts/build.mjs",
    "preview:cloudflare": "wrangler dev --config .cloudflare-release/wrangler.json",
    "preview:pages": "node scripts/serve.mjs --site dist"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "basecoat-css": "1.1.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5"
  }
}
